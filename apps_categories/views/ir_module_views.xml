<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- SEARCH View -->
    <record id="view_module_kanban_category" model="ir.ui.view">
        <field name="name">apps_categories.ir_module_module.search</field>
        <field name="model">ir.module.module</field>
        <field name="inherit_id" ref="base.view_module_filter" />
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='category']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//filter[@name='category']" position="after">
                <filter
                    name="category_name"
                    string="Category"
                    domain="[]"
                    context="{'group_by':'category_name'}"
                />
            </xpath>
        </field>
    </record>
</odoo>
